<view class="battle-page">
  <view class="page-heading">
    <text class="page-kicker">卡牌对战</text>
    <text class="turn-label">{{turnLabel}}</text>
  </view>

  <view class="status-banner {{statusTone}}">
    <text>{{statusText}}</text>
  </view>

  <view wx:for="{{players}}" wx:for-item="team" wx:for-index="teamIndex" wx:key="name"
    class="team-section {{team.playerIndex === 1 ? 'enemy-team' : 'player-team'}}">
    <view class="team-heading">
      <view>
        <text class="team-name">{{team.name}}</text>
        <text class="team-role">{{team.playerIndex === 0 ? '你' : '对手'}}</text>
      </view>
      <text class="team-index">{{team.playerIndex === 0 ? '01' : '02'}}</text>
    </view>
    <view class="card-row">
      <view wx:for="{{team.cards}}" wx:for-item="card" wx:for-index="cardIndex" wx:key="name"
        class="unit-card {{card.isDead ? 'is-dead' : ''}} {{card.isSelected ? 'is-selected' : ''}} {{card.canTarget ? 'is-targetable' : ''}}"
        bindtap="onCardTap" data-player-index="{{team.playerIndex}}" data-card-index="{{cardIndex}}">
        <view class="card-heading">
          <text class="card-name">{{card.name}}</text>
          <text class="attack-value">{{card.attack}}</text>
        </view>
        <text class="stat-caption">攻击</text>
        <view class="health-label">
          <text>生命</text>
          <text>{{card.hp}} / {{card.maxHp}}</text>
        </view>
        <view class="health-track">
          <view class="health-fill {{card.healthTone}}" style="width: {{card.hpPercent}}%;"></view>
        </view>
        <text wx:if="{{card.isDead}}" class="card-state">已倒下</text>
        <text wx:elif="{{card.isSelected}}" class="card-state">攻击者</text>
        <text wx:elif="{{card.canTarget}}" class="card-state">可攻击</text>
      </view>
    </view>
    <view wx:if="{{teamIndex === 0}}" class="versus-row">
      <view class="versus-line"></view>
      <text>VS</text>
      <view class="versus-line"></view>
    </view>
  </view>

  <view class="log-section">
    <view class="log-heading">
      <text class="log-title">战斗记录</text>
      <text class="log-count">{{logs.length}} 条</text>
    </view>
    <scroll-view class="log-panel" scroll-y scroll-into-view="{{logScrollTarget}}" scroll-with-animation="true">
      <view wx:for="{{logs}}" wx:key="id" id="{{item.id}}" class="log-entry {{item.tone}}">
        {{item.message}}
      </view>
    </scroll-view>
  </view>

  <button class="reset-button" bindtap="onReset">重新开始</button>
</view>
