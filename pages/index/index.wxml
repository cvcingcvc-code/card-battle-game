<view class="battle-page">
  <view class="page-heading">
    <text class="page-kicker">本地对局</text>
    <text class="roster-count">3 VS 3</text>
  </view>

  <view class="team-section enemy-team">
    <view class="team-heading">
      <view>
        <text class="team-name">玩家B</text>
        <text class="team-role">对手</text>
      </view>
      <text class="team-index">02</text>
    </view>
    <view class="card-row">
      <view wx:for="{{players[1].cards}}" wx:key="name" class="unit-card {{item.isDead ? 'is-dead' : ''}}">
        <view class="card-heading">
          <text class="card-name">{{item.name}}</text>
          <text class="attack-value">{{item.attack}}</text>
        </view>
        <text class="stat-caption">ATK</text>
        <view class="health-label">
          <text>HP</text>
          <text>{{item.hp}} / {{item.maxHp}}</text>
        </view>
        <view class="health-track">
          <view class="health-fill" style="width: {{item.hpPercent}}%;"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="versus-row">
    <view class="versus-line"></view>
    <text>VS</text>
    <view class="versus-line"></view>
  </view>

  <view class="team-section player-team">
    <view class="team-heading">
      <view>
        <text class="team-name">玩家A</text>
        <text class="team-role">你</text>
      </view>
      <text class="team-index">01</text>
    </view>
    <view class="card-row">
      <view wx:for="{{players[0].cards}}" wx:key="name" class="unit-card {{item.isDead ? 'is-dead' : ''}}">
        <view class="card-heading">
          <text class="card-name">{{item.name}}</text>
          <text class="attack-value">{{item.attack}}</text>
        </view>
        <text class="stat-caption">ATK</text>
        <view class="health-label">
          <text>HP</text>
          <text>{{item.hp}} / {{item.maxHp}}</text>
        </view>
        <view class="health-track">
          <view class="health-fill" style="width: {{item.hpPercent}}%;"></view>
        </view>
      </view>
    </view>
  </view>
</view>
