.battle-page { min-height: 100vh; padding: 32rpx 26rpx 28rpx; padding-bottom: calc(28rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(28rpx + env(safe-area-inset-bottom)); background: #0b1116; }
.page-heading, .team-heading, .team-name-row, .card-heading, .health-label, .log-heading, .selection-heading { display: flex; align-items: center; justify-content: space-between; }
.page-heading { margin-bottom: 26rpx; }
.page-kicker { display: block; color: #b99b6b; font-size: 18rpx; letter-spacing: 5rpx; }
.page-title { display: block; margin-top: 8rpx; color: #f2eee6; font-size: 42rpx; font-weight: 700; letter-spacing: 4rpx; }
.round-badge { display: flex; align-items: center; padding: 12rpx 22rpx; border: 1rpx solid #3b3b33; border-radius: 30rpx; background: #161d21; }
.round-caption { color: #a4ada9; font-size: 24rpx; }
.round-value { margin-left: 14rpx; color: #d8be8b; font-size: 32rpx; font-weight: 700; }
.status-banner { display: flex; align-items: center; min-height: 106rpx; margin-bottom: 30rpx; padding: 18rpx 22rpx; border: 1rpx solid #3b3a2f; border-radius: 12rpx; background: #1c201e; }
.status-light { flex-shrink: 0; width: 12rpx; height: 12rpx; margin-right: 18rpx; border-radius: 50%; background: #c8a66a; box-shadow: 0 0 20rpx #76643d; }
.status-copy { flex: 1; min-width: 0; }
.turn-label { display: block; color: #d9bc87; font-size: 24rpx; font-weight: 600; }
.status-text { display: block; margin-top: 4rpx; color: #e4e4db; font-size: 28rpx; line-height: 1.5; }
.status-banner.target { border-color: #416150; background: #182822; }
.status-banner.target .status-light { background: #8fc8b0; }
.status-banner.waiting { border-color: #4d3f39; background: #221f1e; }
.status-banner.waiting .status-light { background: #d98a79; box-shadow: 0 0 16rpx #65463d; }
.team-section { width: 100%; }
.team-heading { min-height: 50rpx; margin-bottom: 14rpx; }
.team-name-row { justify-content: flex-start; min-width: 0; }
.team-marker { width: 6rpx; height: 26rpx; margin-right: 12rpx; border-radius: 2rpx; background: #d98a79; }
.player-team .team-marker { background: #8fc8b0; }
.team-name { color: #e8e8df; font-size: 29rpx; font-weight: 600; }
.team-role { margin-left: 12rpx; color: #8a9897; font-size: 22rpx; }
.team-index { flex-shrink: 0; margin-left: 8rpx; color: #9aa6a2; font-size: 23rpx; }
.card-row { display: flex; width: 100%; }
.unit-card { flex: 1; width: 0; min-width: 0; overflow: hidden; border: 2rpx solid #42413a; border-radius: 13rpx; background: #192229; }
.unit-card + .unit-card { margin-left: 20rpx; }
.player-team .unit-card { border-color: #3c5149; }
.unit-card.is-selected { border-color: #e4bd75; box-shadow: 0 0 0 2rpx #4d412a, 0 6rpx 26rpx #000000; }
.unit-card.is-targetable { border-color: #c88574; box-shadow: 0 0 0 2rpx #47332e; }
.unit-card.is-dead { opacity: 0.4; }
.card-pressed { opacity: 0.78; }
.card-portrait { position: relative; height: 206rpx; overflow: hidden; background: #222a2c; }
.portrait-image { width: 100%; height: 100%; }
.portrait-shade { position: absolute; right: 0; bottom: 0; left: 0; height: 105rpx; background: linear-gradient(transparent, #10171e); }
.card-role { position: absolute; top: 12rpx; left: 10rpx; color: #e5d6b6; font-size: 18rpx; letter-spacing: 2rpx; }
.card-name { position: absolute; right: 8rpx; bottom: 12rpx; left: 12rpx; color: #f4efe4; font-size: 28rpx; font-weight: 700; white-space: nowrap; }
.card-state { position: absolute; top: 46rpx; left: 10rpx; padding: 5rpx 8rpx; border: 1rpx solid #777065; border-radius: 4rpx; background: #232b30; color: #e2ddd1; font-size: 20rpx; }
.selected-state { border-color: #b99b60; background: #3d3323; color: #ffe4a8; }
.target-state { border-color: #b97563; background: #442b28; color: #ffd0bf; }
.card-body { padding: 9rpx 12rpx 12rpx; }
.card-heading { min-height: 38rpx; }
.stat-caption { color: #a4afa9; font-size: 22rpx; }
.attack-value { color: #e1bc7a; font-size: 32rpx; font-weight: 700; }
.health-label { margin-top: 7rpx; color: #d5ddd5; font-size: 23rpx; }
.max-health { color: #83928d; font-size: 21rpx; }
.health-track { height: 7rpx; margin-top: 8rpx; overflow: hidden; border-radius: 4rpx; background: #303e3a; }
.health-fill { height: 100%; border-radius: 4rpx; background: #8fc8b0; transition: width 0.25s; }
.health-fill.low { background: #c8a66a; }
.health-fill.critical { background: #d98a79; }
.card-skill { display: block; margin-top: 12rpx; overflow: hidden; color: #dfc490; font-size: 22rpx; line-height: 1.5; white-space: nowrap; text-overflow: ellipsis; }
.card-skill.used { color: #8b9993; }
.versus-row { display: flex; align-items: center; margin: 20rpx 0 16rpx; color: #a89067; font-size: 20rpx; letter-spacing: 8rpx; }
.versus-line { flex: 1; height: 1rpx; background: #333830; }
.versus-row text { margin: 0 20rpx; }
.selection-panel { margin-top: 24rpx; padding: 22rpx; border: 1rpx solid #29373b; border-radius: 12rpx; background: #131d24; }
.selection-name { color: #e6d5b1; font-size: 28rpx; font-weight: 600; }
.selection-role { margin-left: 16rpx; color: #94b7a9; font-size: 23rpx; }
.selection-description { display: block; margin-top: 10rpx; color: #b1bdb5; font-size: 27rpx; line-height: 1.65; }
.selection-hint { display: block; margin-top: 14rpx; color: #d3b982; font-size: 25rpx; line-height: 1.55; }
.skill-panel { display: flex; align-items: center; justify-content: space-between; margin-top: 14rpx; padding: 22rpx; border: 1rpx solid #625235; border-radius: 12rpx; background: #24231c; }
.skill-copy { flex: 1; min-width: 0; margin-right: 16rpx; }
.skill-name { display: block; color: #e8cb91; font-size: 30rpx; font-weight: 700; }
.skill-description { display: block; margin-top: 7rpx; color: #e2ddd0; font-size: 27rpx; line-height: 1.5; }
.skill-limit { display: block; margin-top: 10rpx; color: #a69c81; font-size: 22rpx; line-height: 1.5; }
.skill-button { flex-shrink: 0; width: 176rpx; height: 112rpx; margin: 0; padding: 0 8rpx; border: 1rpx solid #e3c18a; border-radius: 9rpx; background: #c8a66a; color: #1a1e1a; font-size: 26rpx; font-weight: 700; line-height: 110rpx; }
.skill-button[disabled] { border-color: #716443; background: #665b41; color: #c2b592; opacity: 0.7; }
.skill-button-pressed { background: #e3c591; }
.log-section { margin-top: 30rpx; }
.log-heading { margin-bottom: 14rpx; }
.log-title { color: #dddacf; font-size: 28rpx; font-weight: 600; }
.log-count { color: #83948d; font-size: 23rpx; }
.log-panel { height: 230rpx; padding: 14rpx 20rpx; border: 1rpx solid #2a383b; border-radius: 10rpx; background: #10191f; box-sizing: border-box; }
.log-entry { padding: 8rpx 0; color: #a4b4aa; font-size: 26rpx; line-height: 1.65; }
.log-entry + .log-entry { border-top: 1rpx solid #1d2b2e; }
.log-entry.hit { color: #d8ac96; }
.log-entry.kill, .log-entry.result { color: #e8c688; font-weight: 600; }
.battle-actions { margin-top: 28rpx; }
.reset-button { height: 112rpx; margin: 0; border: 1rpx solid #7f704d; border-radius: 12rpx; background: #26342e; color: #e5dec9; font-size: 28rpx; font-weight: 600; line-height: 110rpx; }
.reset-button-pressed { background: #3b4b3c; }
.leave-button { min-height: 108rpx; margin-top: 8rpx; border: 0; background: transparent; color: #a5b4aa; font-size: 27rpx; line-height: 106rpx; }
.quiet-button-pressed { color: #f1debb; background: #182321; }
.page-footer { display: block; margin-top: 24rpx; color: #64756d; font-size: 20rpx; letter-spacing: 7rpx; text-align: center; }
.result-panel { position: relative; margin-bottom: 36rpx; padding: 32rpx 26rpx 8rpx; overflow: hidden; border: 1rpx solid #75623d; border-radius: 18rpx; background: linear-gradient(145deg, #293127, #16251f); text-align: center; }
.result-emblem { display: flex; align-items: center; justify-content: center; width: 100rpx; height: 100rpx; margin: 0 auto 22rpx; border: 1rpx solid #b3985f; border-radius: 50%; color: #e4c283; font-size: 48rpx; }
.result-eyebrow { display: block; color: #bfa36e; font-size: 23rpx; letter-spacing: 8rpx; }
.result-title { display: block; margin-top: 12rpx; color: #f1e5c9; font-size: 48rpx; font-weight: 700; letter-spacing: 4rpx; }
.result-description { display: block; margin: 16rpx 8rpx 0; color: #bac9b7; font-size: 27rpx; line-height: 1.65; }
.result-stats { display: flex; margin: 30rpx 0 0; padding: 24rpx 0; border-top: 1rpx solid #4a5140; border-bottom: 1rpx solid #4a5140; }
.result-stat { flex: 1; }
.result-stat + .result-stat { border-left: 1rpx solid #46513e; }
.result-value { display: block; color: #f0d49c; font-size: 42rpx; font-weight: 700; }
.result-label { display: block; margin-top: 6rpx; color: #acbba6; font-size: 24rpx; }
.result-footnote { display: flex; justify-content: space-between; margin: 20rpx 8rpx 28rpx; color: #9cafa1; font-size: 24rpx; }
.result-rematch { border-color: #c8a66a; background: #c8a66a; color: #18231c; }
.is-defeat { border-color: #72564b; background: linear-gradient(145deg, #302624, #201d23); }
.is-defeat .result-emblem { border-color: #9c7661; color: #d6a68a; }
.is-defeat .result-description { color: #c2b3a7; }
@media (min-width: 600px) { .battle-page { max-width: 1000px; margin: 0 auto; } }
