page {
  background: #0b1116;
  color: #f2eee5;
}

.home-page {
  min-height: 100vh;
  padding-bottom: 36rpx;
  padding-bottom: calc(36rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
  background: #0b1116;
}

.hero {
  position: relative;
  height: 632rpx;
  overflow: hidden;
  background: #151e25;
}

.hero-art {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 560rpx;
}

.hero-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(11, 17, 22, 0.12) 0%, rgba(11, 17, 22, 0) 36%, rgba(11, 17, 22, 0.76) 68%, #0b1116 93%);
}

.hero-mark {
  position: absolute;
  top: 38rpx;
  left: 40rpx;
  right: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mark-line {
  width: 44rpx;
  height: 1rpx;
  background: rgba(200, 166, 106, 0.55);
}

.mark-diamond {
  width: 8rpx;
  height: 8rpx;
  margin: 0 18rpx;
  background: #c8a66a;
  transform: rotate(45deg);
}

.hero-kicker {
  font-size: 26rpx;
  line-height: 40rpx;
  letter-spacing: 3rpx;
  color: #f1e0be;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.8);
}

.hero-heading {
  position: absolute;
  right: 30rpx;
  bottom: 18rpx;
  left: 30rpx;
  display: flex;
  align-items: center;
  flex-direction: column;
}

.game-title {
  display: block;
  color: #f4e3c2;
  font-size: 84rpx;
  line-height: 112rpx;
  letter-spacing: 12rpx;
  text-indent: 12rpx;
  font-weight: 600;
  font-family: "Songti SC", "Noto Serif CJK SC", serif;
  text-shadow: 0 4rpx 30rpx #060b0f;
}

.title-rule {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 250rpx;
  height: 2rpx;
  margin: 15rpx 0 26rpx;
  background: linear-gradient(90deg, transparent, #c8a66a, transparent);
}

.title-diamond {
  width: 10rpx;
  height: 10rpx;
  border: 2rpx solid #c8a66a;
  background: #0b1116;
  transform: rotate(45deg);
}

.game-subtitle {
  display: block;
  color: #d8c49e;
  font-size: 30rpx;
  line-height: 48rpx;
  letter-spacing: 3rpx;
}

.home-content {
  padding: 0 36rpx;
}

.opening {
  padding-top: 12rpx;
  text-align: center;
}

.opening-description {
  display: block;
  color: #a7b2b8;
  font-size: 28rpx;
  line-height: 46rpx;
  white-space: pre-line;
}

.start-button {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  min-height: 112rpx;
  margin: 34rpx 0 0;
  padding: 22rpx 32rpx;
  border: 1rpx solid #e3c48b;
  border-radius: 12rpx;
  background: linear-gradient(110deg, #d5b47b, #b99255);
  color: #211a10;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 56rpx;
  letter-spacing: 5rpx;
  box-shadow: 0 10rpx 32rpx rgba(200, 166, 106, 0.11);
}

.start-button::after,
.rules-toggle::after {
  border: none;
}

.start-button[disabled] {
  color: #42341e;
  background: #bba075;
  border-color: #bba075;
}

.start-button-pressed {
  background: #b59259;
  transform: translateY(2rpx);
}

.start-arrow {
  margin-left: 24rpx;
  font-size: 46rpx;
  line-height: 48rpx;
  font-weight: 400;
}

.opening-note {
  display: block;
  margin-top: 20rpx;
  color: #91a0aa;
  font-size: 26rpx;
  line-height: 40rpx;
}

.roster-section {
  margin-top: 62rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.heading-diamond {
  flex-shrink: 0;
  width: 9rpx;
  height: 9rpx;
  margin-right: 15rpx;
  transform: rotate(45deg);
}

.ally-diamond {
  background: #8fc8b0;
}

.section-title {
  flex-shrink: 0;
  color: #e7ede8;
  font-size: 32rpx;
  line-height: 46rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.heading-line {
  flex: 1;
  height: 1rpx;
  margin: 0 20rpx;
  background: #2a363d;
}

.section-caption {
  flex-shrink: 0;
  color: #8fc8b0;
  font-size: 26rpx;
  line-height: 40rpx;
}

.team-roster {
  display: flex;
  align-items: stretch;
}

.companion-card {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  overflow: hidden;
  border: 1rpx solid #30423f;
  border-radius: 12rpx;
  background: #151e25;
}

.first-companion {
  margin-left: 0;
}

.companion-portrait {
  position: relative;
  height: 200rpx;
  background: #1c292d;
}

.companion-art {
  width: 100%;
  height: 100%;
}

.portrait-shade {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 60rpx;
  background: linear-gradient(180deg, transparent, #151e25);
}

.companion-copy {
  padding: 8rpx 10rpx 22rpx;
  text-align: center;
}

.companion-name {
  display: block;
  color: #edf0e9;
  font-size: 30rpx;
  line-height: 46rpx;
  font-weight: 600;
}

.companion-role {
  display: block;
  margin-top: 4rpx;
  color: #8fc8b0;
  font-size: 26rpx;
  line-height: 40rpx;
}

.roster-description {
  display: block;
  margin-top: 18rpx;
  color: #9aabb3;
  font-size: 26rpx;
  line-height: 42rpx;
  text-align: center;
}

.enemy-panel {
  margin-top: 32rpx;
  padding: 28rpx;
  border: 1rpx solid #49342f;
  border-radius: 12rpx;
  background: linear-gradient(120deg, #211c20, #151e25);
}

.enemy-title-row {
  display: flex;
  align-items: center;
}

.enemy-diamond {
  background: #d98a79;
}

.enemy-title {
  color: #d98a79;
  font-size: 28rpx;
  line-height: 44rpx;
  letter-spacing: 2rpx;
  font-weight: 600;
}

.enemy-names {
  display: block;
  margin-top: 12rpx;
  color: #e0d4ce;
  font-size: 30rpx;
  line-height: 46rpx;
}

.enemy-description {
  display: block;
  margin-top: 10rpx;
  color: #b5a5a1;
  font-size: 26rpx;
  line-height: 44rpx;
}

.rules-section {
  margin-top: 36rpx;
  overflow: hidden;
  border: 1rpx solid #2d383e;
  border-radius: 12rpx;
  background: #11191f;
}

.rules-section-open {
  border-color: #655637;
}

.rules-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 110rpx;
  margin: 0;
  padding: 26rpx 28rpx;
  border-radius: 0;
  background: transparent;
  color: #e1d4bb;
  font-size: 30rpx;
  line-height: 54rpx;
  text-align: left;
}

.rules-toggle-pressed {
  background: #1c252b;
}

.rules-toggle-label {
  display: flex;
  align-items: center;
}

.rules-symbol {
  width: 42rpx;
  height: 42rpx;
  margin-right: 18rpx;
  border: 1rpx solid #8c764d;
  border-radius: 50%;
  color: #c8a66a;
  font-size: 28rpx;
  line-height: 40rpx;
  font-family: Georgia, serif;
  text-align: center;
}

.rules-toggle-icon {
  margin-left: 16rpx;
  color: #c8a66a;
  font-size: 38rpx;
  line-height: 48rpx;
}

.rules-content {
  margin: 0 28rpx;
  padding: 28rpx 0 6rpx;
  border-top: 1rpx solid #30373a;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.rule-number {
  flex-shrink: 0;
  margin-right: 20rpx;
  color: #c8a66a;
  font-size: 26rpx;
  line-height: 46rpx;
  font-family: Georgia, serif;
}

.rule-copy {
  flex: 1;
  min-width: 0;
}

.rule-title {
  display: block;
  color: #e4dfd4;
  font-size: 28rpx;
  line-height: 46rpx;
  font-weight: 600;
}

.rule-description {
  display: block;
  margin-top: 8rpx;
  color: #a5b0b6;
  font-size: 26rpx;
  line-height: 44rpx;
}

.skills-list {
  margin: 0 0 30rpx 52rpx;
  padding: 6rpx 22rpx;
  border-left: 2rpx solid #655637;
  background: #151e25;
}

.skill-item {
  padding: 18rpx 0;
}

.skill-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.skill-name {
  margin-right: 16rpx;
  color: #d6bc8a;
  font-size: 28rpx;
  line-height: 42rpx;
}

.skill-owner {
  color: #93a2ab;
  font-size: 26rpx;
  line-height: 42rpx;
}

.skill-description {
  display: block;
  margin-top: 6rpx;
  color: #b5bfc1;
  font-size: 26rpx;
  line-height: 42rpx;
}

.last-rule {
  margin-bottom: 24rpx;
}

.footer-ornament {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 46rpx;
  opacity: 0.55;
}

.footer-line {
  width: 70rpx;
  height: 1rpx;
  background: #6b604b;
}

.footer-copy {
  display: block;
  margin-top: 20rpx;
  color: #7e8d95;
  font-size: 26rpx;
  line-height: 42rpx;
  letter-spacing: 4rpx;
  text-align: center;
}

.about-button { height: 108rpx; margin: 14rpx 0 0; border: 0; background: transparent; color: #b4b7a7; font-size: 26rpx; line-height: 106rpx; }
.about-button-pressed { background: #18231f; color: #e3c591; }
